package Parse;

action code {: static Symbol.Symbol sym(String s) {
	         return Symbol.Symbol.symbol(s);
	        }
	    :};

parser code  {: 
  Lexer lexer;

  public void syntax_error(java_cup.runtime.Symbol current) {
   report_error("Syntax error (" + current.sym + ")", current);
  }

  ErrorMsg.ErrorMsg errorMsg;

  public void report_error(String message, java_cup.runtime.Symbol info) {
      errorMsg.error(info.left, message);
  }

  public Grm(Lexer l, ErrorMsg.ErrorMsg err) {
    this();
    errorMsg=err;
    lexer=l;
  }
:};

scan with {: return lexer.nextToken(); :};

terminal String ID, STRING_LITERAL, CHAR_LITERAL;
terminal Integer DECIMAL_LITERAL;
terminal SHORT, TIMES, GT, ARROW, DIVASSIGN, CONST, PREDEC, GE, PERIOD, REGISTER,
  ENUM, RBRACK, SIZEOF, COMMA, RBRACE, RPAREN, LBRACK, LT, INCREMENT, SUBASSIGN,
  DOUBLE, BWISEANDASSIGN, STRUCT, LBRACE, LPAREN, MODASSIGN, NOT, TILDE, LE,
  ADDRESS, VAR, BITWISEAND, FLOAT, GOTO, EQ, LSHIFTASSIGN, MODULUS, LONG, PLUS,
  DIVIDE, PREINC, WHILE, UNION, ASSIGN, CHAR, ADDASSIGN, DO, FOR, VOID, EXTERN,
  RETURN, ELSE, BREAK, FUN, INT, SEMICOLON, ELIPSES, MULASSIGN, DECREMENT, MINUS,
  OR, CONTINUE, IF, BWISEOR, COLON, BWISEXOR, DEREF, BWISEORASSIGN, RSHIFTASSIGN,
  VOLATILE, RSHIFT, BWISEXORASSIGN, NEQ, AND, UMINUS, STATIC, LSHIFT, TYPEDEF,
  AUTO, CASE, DEFAULT, SIGNED, SWITCH, UNSIGNED, QUESTION, LOWER_THAN_ELSE;

/* expressions (typed: they build Absyn nodes) */
non terminal Absyn.Exp primary_expression, postfix_expression, unary_expression,
  cast_expression, multiplication_expression, additive_exression, shift_expression,
  relational_expression, equality_expression, and_expression, exclusive_or_expression,
  inclusive_or_expression, logical_and_expression, logical_or_expression,
  conditional_expression, constant_expression, assignment_expression, expression,
  test_start;
non terminal java.util.LinkedList argument_expression_list;
non terminal String unary_operator, assignment_operator;

/* statements (no actions yet) */
non terminal statement;
non terminal labeled_statement;
non terminal compound_statement;
non terminal declaration_list;
non terminal statement_list;
non terminal expression_statement;
non terminal selection_statement;
non terminal iteration_statement;
non terminal jump_statement;

/* course declaration grammar (no actions yet) */
non terminal translation_unit;
non terminal declaration;
non terminal name;
non terminal bitfield_list;
non terminal bitfield_value;
non terminal empty_array_type_list;
non terminal empty_array_type;
non terminal expression_array_type_list;
non terminal expression_array_type;
non terminal type;
non terminal type_augments;
non terminal brackets_list;
non terminal pointer_list;
non terminal type_name;
non terminal initialization;
non terminal struct_or_union_declarator;
non terminal enumerator_list;
non terminal enumerator;
non terminal struct_declaration_list;
non terminal struct_or_union;
non terminal type_parameters;
non terminal parameters;
non terminal parameter_list;
non terminal parameter_type_list;
non terminal initializer_list;
non terminal initializer;

precedence nonassoc LOWER_THAN_ELSE;
precedence nonassoc ELSE;

/* TEMPORARY start symbol so expressions can be tested alone.
   Replaced by translation_unit once statements and declarations have actions. */
start with test_start;

test_start ::= expression:e {: RESULT = e; :} ;

translation_unit ::=
  /* empty */
  | translation_unit declaration
  ;

/*3.3.1 primary expressions*/
primary_expression ::=
    ID:n                    {: RESULT = new Absyn.IdExp(nleft, sym(n)); :}
  | DECIMAL_LITERAL:v       {: RESULT = new Absyn.IntLiteral(vleft, v); :}
  | CHAR_LITERAL:v          {: RESULT = new Absyn.CharLiteral(vleft, v); :}
  | STRING_LITERAL:v        {: RESULT = new Absyn.StringLiteral(vleft, v); :}
  | LPAREN:p expression:e RPAREN {: RESULT = new Absyn.ParenExp(pleft, e); :}
  ;

/*3.3.2 postfix*/
postfix_expression ::=
    primary_expression:e    {: RESULT = e; :}
  | postfix_expression:a LBRACK expression:i RBRACK
        {: RESULT = new Absyn.IndexExp(aleft, a, i); :}
  | postfix_expression:f LPAREN RPAREN
        {: RESULT = new Absyn.FunctionCall(fleft, f, new java.util.LinkedList()); :}
  | postfix_expression:f LPAREN argument_expression_list:a RPAREN
        {: RESULT = new Absyn.FunctionCall(fleft, f, a); :}
  | postfix_expression:e PERIOD ID:n
        {: RESULT = new Absyn.FieldAccess(eleft, e, ".", sym(n)); :}
  | postfix_expression:e ARROW ID:n
        {: RESULT = new Absyn.FieldAccess(eleft, e, "->", sym(n)); :}
  | postfix_expression:e INCREMENT {: RESULT = new Absyn.PostfixExp(eleft, e, "++"); :}
  | postfix_expression:e DECREMENT {: RESULT = new Absyn.PostfixExp(eleft, e, "--"); :}
  ;

argument_expression_list ::=
    assignment_expression:e
        {: java.util.LinkedList l = new java.util.LinkedList(); l.add(e); RESULT = l; :}
  | argument_expression_list:l COMMA assignment_expression:e
        {: l.add(e); RESULT = l; :}
  ;

/* 3.3.3 unary operators*/
unary_expression ::=
    postfix_expression:e    {: RESULT = e; :}
  | INCREMENT:o unary_expression:e {: RESULT = new Absyn.UnaryExp(oleft, "++", e); :}
  | DECREMENT:o unary_expression:e {: RESULT = new Absyn.UnaryExp(oleft, "--", e); :}
  | unary_operator:o cast_expression:e {: RESULT = new Absyn.UnaryExp(oleft, o, e); :}
  | SIZEOF LPAREN type RPAREN   /* action added with the types group */
  ;

unary_operator ::=
    BITWISEAND {: RESULT = "&"; :}
  | TIMES      {: RESULT = "*"; :}
  | PLUS       {: RESULT = "+"; :}
  | MINUS      {: RESULT = "-"; :}
  | TILDE      {: RESULT = "~"; :}
  | NOT        {: RESULT = "!"; :}
  ;

/*3.3.4 (no cast rule, per assignment)*/
cast_expression ::=
    unary_expression:e {: RESULT = e; :}
  ;

/*3.3.5*/
multiplication_expression ::=
    cast_expression:e {: RESULT = e; :}
  | multiplication_expression:l TIMES cast_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "*", r); :}
  | multiplication_expression:l DIVIDE cast_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "/", r); :}
  | multiplication_expression:l MODULUS cast_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "%", r); :}
  ;

/*3.3.6 additive*/
additive_exression ::=
    multiplication_expression:e {: RESULT = e; :}
  | additive_exression:l PLUS multiplication_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "+", r); :}
  | additive_exression:l MINUS multiplication_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "-", r); :}
  ;

/*3.3.7 bitwise shift*/
shift_expression ::=
    additive_exression:e {: RESULT = e; :}
  | shift_expression:l LSHIFT additive_exression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "<<", r); :}
  | shift_expression:l RSHIFT additive_exression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, ">>", r); :}
  ;

/* 3.3.8 relational*/
relational_expression ::=
    shift_expression:e {: RESULT = e; :}
  | relational_expression:l LT shift_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "<", r); :}
  | relational_expression:l GT shift_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, ">", r); :}
  | relational_expression:l LE shift_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "<=", r); :}
  | relational_expression:l GE shift_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, ">=", r); :}
  ;

/*3.3.9 equality*/
equality_expression ::=
    relational_expression:e {: RESULT = e; :}
  | equality_expression:l EQ relational_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "==", r); :}
  | equality_expression:l NEQ relational_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "!=", r); :}
  ;

/*3.3.10 bitwise and */
and_expression ::=
    equality_expression:e {: RESULT = e; :}
  | and_expression:l BITWISEAND equality_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "&", r); :}
  ;

/*3.3.11 bitwise exclusive or*/
exclusive_or_expression ::=
    and_expression:e {: RESULT = e; :}
  | exclusive_or_expression:l BWISEXOR and_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "^", r); :}
  ;

/*3.3.12 bitwise inclusive or*/
inclusive_or_expression ::=
    exclusive_or_expression:e {: RESULT = e; :}
  | inclusive_or_expression:l BWISEOR exclusive_or_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "|", r); :}
  ;

/*3.3.13 logical and*/
logical_and_expression ::=
    inclusive_or_expression:e {: RESULT = e; :}
  | logical_and_expression:l AND inclusive_or_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "&&", r); :}
  ;

/*3.3.14 logical or */
logical_or_expression ::=
    logical_and_expression:e {: RESULT = e; :}
  | logical_or_expression:l OR logical_and_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, "||", r); :}
  ;

/*3.3.15 conditional*/
conditional_expression ::=
    logical_or_expression:e {: RESULT = e; :}
  | logical_or_expression:t QUESTION expression:a COLON conditional_expression:b
        {: RESULT = new Absyn.ConditionalExp(tleft, t, a, b); :}
  ;

/*3.3.16 assignment*/
assignment_expression ::=
    conditional_expression:e {: RESULT = e; :}
  | unary_expression:t assignment_operator:o assignment_expression:v
        {: RESULT = new Absyn.Assignment(tleft, t, o, v); :}
  ;

assignment_operator ::=
    ASSIGN         {: RESULT = "="; :}
  | MULASSIGN      {: RESULT = "*="; :}
  | DIVASSIGN      {: RESULT = "/="; :}
  | MODASSIGN      {: RESULT = "%="; :}
  | ADDASSIGN      {: RESULT = "+="; :}
  | SUBASSIGN      {: RESULT = "-="; :}
  | LSHIFTASSIGN   {: RESULT = "<<="; :}
  | RSHIFTASSIGN   {: RESULT = ">>="; :}
  | BWISEANDASSIGN {: RESULT = "&="; :}
  | BWISEXORASSIGN {: RESULT = "^="; :}
  | BWISEORASSIGN  {: RESULT = "|="; :}
  ;

/*3.3.17 comma (a BinaryExp with op ",") */
expression ::=
    assignment_expression:e {: RESULT = e; :}
  | expression:l COMMA assignment_expression:r
        {: RESULT = new Absyn.BinaryExp(lleft, l, ",", r); :}
  ;

/*constant expressions*/
constant_expression ::=
    conditional_expression:e {: RESULT = e; :}
  ;

/* 3.6 statements (switch removed per assignment)*/
statement ::=
  labeled_statement
  | compound_statement
  | expression_statement
  | selection_statement
  | iteration_statement
  | jump_statement
  ;

/*3.6.1 labeled statements*/
labeled_statement ::=
  ID COLON statement
  ;

/*3.6.2 compound statement or block*/
compound_statement ::=
  LBRACE declaration_list statement_list RBRACE
  | LBRACE declaration_list RBRACE
  | LBRACE statement_list RBRACE
  | LBRACE RBRACE
  ;

declaration_list ::=
  declaration
  | declaration_list declaration
  ;

statement_list ::=
  statement
  | statement_list statement
  ;

/*3.6.3 expression and null */
expression_statement ::=
  expression SEMICOLON
  | SEMICOLON
  ;

/*3.6.4 selection statement*/
selection_statement ::=
  IF LPAREN expression RPAREN statement %prec LOWER_THAN_ELSE
  | IF LPAREN expression RPAREN statement ELSE statement
  ;

/* 3.6.5 iteration statements*/
iteration_statement ::=
	  WHILE LPAREN expression RPAREN statement
	| DO statement WHILE LPAREN expression RPAREN SEMICOLON
	| FOR LPAREN expression SEMICOLON expression SEMICOLON expression RPAREN statement
	| FOR LPAREN expression SEMICOLON expression SEMICOLON            RPAREN statement
	| FOR LPAREN expression SEMICOLON            SEMICOLON expression RPAREN statement
	| FOR LPAREN expression SEMICOLON            SEMICOLON            RPAREN statement
	| FOR LPAREN            SEMICOLON expression SEMICOLON expression RPAREN statement
	| FOR LPAREN            SEMICOLON expression SEMICOLON            RPAREN statement
	| FOR LPAREN            SEMICOLON            SEMICOLON expression RPAREN statement
	| FOR LPAREN            SEMICOLON            SEMICOLON            RPAREN statement
	;

/*3.6.6 jump statements*/
jump_statement ::=
  GOTO ID SEMICOLON
  | CONTINUE SEMICOLON
  | BREAK SEMICOLON
  | RETURN expression SEMICOLON
  | RETURN SEMICOLON
  ;

/* ---------- declarations (course grammar from Moodle) ---------- */
declaration ::=
  VAR bitfield_list type name initialization SEMICOLON
  | FUN bitfield_list type name parameters compound_statement
  | FUN bitfield_list type name type_parameters SEMICOLON
  | TYPEDEF type name SEMICOLON
  | bitfield_list struct_or_union name struct_or_union_declarator
  | ENUM ID LBRACE enumerator_list RBRACE
  ;

name ::= ID ;

bitfield_list ::=
  /* empty */
  | bitfield_value bitfield_list
  ;

bitfield_value ::= CONST | VOLATILE | EXTERN | STATIC | AUTO | REGISTER ;

empty_array_type_list ::=
  empty_array_type
  | empty_array_type_list empty_array_type
  ;

empty_array_type ::= LBRACK RBRACK ;

expression_array_type_list ::=
  expression_array_type
  | expression_array_type_list expression_array_type
  ;

expression_array_type ::= LBRACK constant_expression RBRACK ;

type ::=
  type_name type_augments
  | type_name
  ;

type_augments ::=
  pointer_list
  | brackets_list
  | pointer_list brackets_list
  ;

brackets_list ::=
  empty_array_type_list
  | expression_array_type_list
  ;

pointer_list ::=
  TIMES
  | pointer_list TIMES
  ;

type_name ::=
  VOID | CHAR | SHORT | INT | LONG | FLOAT | DOUBLE
  | ENUM ID
  | ID
  ;

initialization ::=
  /* empty */
  | ASSIGN initializer
  ;

struct_or_union_declarator ::=
  LBRACE struct_declaration_list RBRACE
  ;

enumerator_list ::=
  enumerator
  | enumerator_list COMMA enumerator
  ;

enumerator ::=
  ID
  | ID ASSIGN constant_expression
  ;

struct_declaration_list ::=
  type name SEMICOLON
  | struct_declaration_list type name SEMICOLON
  ;

struct_or_union ::= STRUCT | UNION ;

type_parameters ::=
  LPAREN parameter_type_list RPAREN
  | LPAREN parameter_type_list COMMA ELIPSES RPAREN
  | LPAREN RPAREN
  ;

parameters ::=
  LPAREN parameter_list RPAREN
  | LPAREN parameter_list COMMA ELIPSES RPAREN
  | LPAREN RPAREN
  ;

parameter_list ::=
  type name
  | parameter_list COMMA type name
  ;

parameter_type_list ::=
  type
  | parameter_type_list COMMA type
  ;

initializer_list ::=
  initializer
  | initializer_list COMMA initializer
  ;

initializer ::=
  assignment_expression
  | LBRACE initializer_list RBRACE
  ;