package Parse;

action code {: static Symbol.Symbol sym(String s) {
	         return Symbol.Symbol.symbol(s);
	        }
	    :};

parser code  {: 
  Lexer lexer;

  public void syntax_error(java_cup.runtime.Symbol current) {
   report_error("Syntax error (" + current.sym + ")", current);
  }

  ErrorMsg.ErrorMsg errorMsg;

  public void report_error(String message, java_cup.runtime.Symbol info) {
      errorMsg.error(info.left, message);
  }

  public Grm(Lexer l, ErrorMsg.ErrorMsg err) {
    this();
    errorMsg=err;
    lexer=l;
  }
:};

scan with {: return lexer.nextToken(); :};



terminal String ID, STRING;
terminal Integer INT;
terminal COMMA, COLON, SEMICOLON, LPAREN, RPAREN, LBRACK, RBRACK, 
	LBRACE, RBRACE, DOT, PLUS, MINUS, TIMES, DIVIDE, EQ, NEQ, LT, LE, 
	GT, GE, AND, OR, ASSIGN, ARRAY, IF, THEN, ELSE, WHILE, FOR, TO,
	DO, LET, IN, END, OF, BREAK, NIL, FUNCTION, VAR, TYPE;

  /*C tokents added for 3.3.2*/
  terminal ARROW, INCR, DECR;

  /*C tokents for 3.3.3*/
  terminal SIZEOF, AMP, TILDE, BANG;
  /*temp stand in for type name*/
  terminal TYPENAME;

  /*C token for 3.3.5*/
  terminal MOD;
/*C tokent for 3.3.7*/
  terminal LSHIFT, RSHIFT;

  /*C tokens added for 3.3.11-3.3.14*/
  terminal CARET, PIPE, ANDAND, OROR;

  /* tokens for 3.3.15-3.3.16*/
  terminal QUESTION;
  terminal EQUALS, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN, ADD_ASSIGN, SUB_ASSIGN, 
          LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, XOR_ASSIGN, OR_ASSIGN;

/*3.6.1*/
terminal CASE, DEFAULT;

/* C token 3.6.4*/
terminal SWITCH;
terminal LOWER_THAN_ELSE;

/* token for 3.6.6*/
terminal GOTO, CONTINUE, RETURN;

/*temp need to be taken out later*/




non terminal Absyn.Exp          Exp;
non terminal Absyn.Var          Var;

/* c grammor from c89*/
non terminal primary_expression;
non terminal postfix_expression;
non terminal argument_expression_list;
non terminal unary_expression;
non terminal unary_operator;
non terminal cast_expression;
non terminal multiplication_expression;
non terminal additive_exression;
non terminal shift_expression;
non terminal relational_expression;
non terminal equality_expression;
non terminal and_expression;
non terminal exclusive_or_expression;
non terminal inclusive_or_expression;
non terminal logical_and_expression;
non terminal logical_or_expression;
non terminal conditional_expression;
non terminal constant_expression;
non terminal assignment_operator;
non terminal assignment_expression;
non terminal expression;
non terminal type_name;
non terminal statement;
non terminal labeled_statement;
non terminal compound_statement;
non terminal declaration_list;
non terminal statement_list;
non terminal declatation;
non terminal expression_statement;
non terminal selection_statement;
non terminal iteration_statement;
non terminal jump_statement;
non terminal opt_expression;


precedence nonassoc LOWER_THAN_ELSE;
precedence nonassoc ELSE;

start with Exp;

Exp ::= error:e
	  {: RESULT = new Absyn.SeqExp(eleft, null); :}
	| Var:v
	  {: RESULT = new Absyn.VarExp(vleft, v); :}
	;

Var ::=   ID:n
	  {: RESULT = new Absyn.SimpleVar(nleft, sym(n)); :}
	;


/*3.3.1 primary expressions*/
primary_expression ::=
  ID  :id
  {:RESULT=new Absyn.VarExp(idleft, new Absyn.SimpleVar(idleft, sym(id)));:}
 |INT:x 
 {:RESULT= new Absyn.intexp(x);:}
 | STRING :s
 {:RESULT = new Absyn.stringexp(s);:}
 | LPAREN expression:e RPAREN
 {:RESULT = new Absyn.primaryexp(e);:}
  ;


/*3.3.2 postfix*/
postfix_expression ::=
  primary_expression:e
  {:RESULT=e;:}
|  postfix_expression:e1 LBRACK expression:e2 RBRACK
{:RESULT=new Absyn.SubscriptExp(e1,e2);:}
|  postfix_expression:e1 LPAREN RPAREN
{:RESULT=new Absyn.CallExp(e1, null);:}
|  postfix_expression:e1 LPAREN argument_expression_list:args RPAREN
{:RESULT=new Absyn.CallExp(e1, args);:}
|  postfix_expression:e1 DOT ID:id
{:RESULT=new Absyn.Fieldid(e1, Symbol.symbol(id), false);:}
|  postfix_expression:e1 ARROW ID:id
{:RESULT=new Absyn.FieldExp(e1, Symbol.symbol(id), true);:}
|  postfix_expression INCR:e1
{:RESULT=new Absyn.PostIncExp(e1);:}
|  postfix_expression DECR
{:RESULT= new Absyn.PostDecExp(e1);:}
  ;

argument_expression_list ::=
  assignment_expression:e
  {:RESULT= new Absyn.ExpList(e, null);:}
 | argument_expression_list:e COMMA assignment_expression:l
 {:RESULT= new Absyn.ExpList(e,l);:}
  ;


/* 3.3.3 unary operatiors*/
unary_expression ::=
  postfix_expression:e
  {:RESULT=e;:}
  | INCR unary_expression:e
  {:RESULT=new Absyn.PreDecExp(e);:}
  | DECR unary_expression:e
  {:RESULT=new Absyn.PreDecExp(e);:}
  | unary_operator:op cast_expression:e
  {:RESULT = new Absyn.UnaryExp(op.intValue(),e);:}
  | SIZEOF LPAREN type_name:t RPAREN
  {:RESULT = new Absyn.SizeOfTypeExp(t);:}
  ;

unary_operator ::=
  AMP {:RESULT=Absyn.UnaryExp.ADDR;:}
  | TIMES {:RESULT=Absyn.UnaryExp.DEREF;:}
  | PLUS {:RESULT=Absyn.UnaryExp.PLUS;:}
  | MINUS  {:RESULT=Absyn.UnaryExp.MINUS;:}
  | TILDE {:RESULT=Absyn.UnaryExp.BNOT;:}
  | BANG {:RESULT=Absyn.UnaryExp.LNOT;:}
  ;

/*3.3.4*/
cast_expression ::=
  unary_expression:e
  {:RESULT=e;:}
  ;


/*3.3.5*/
multiplication_expression ::= 
  cast_expression
  | multiplication_expression:n1 TIMES cast_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2, Absyn.BinOp.Op.TIMES):}
  | multiplication_expression:n1 DIVIDE cast_expression:n2
  {:RESULT= new Absyn.BinOp(0, n1,n2,Absyn.BinOp.Op.DIVIDE):}
  | multiplication_expression:n1 MOD cast_expression:n2
  {:RESULT = new Absyn.BinOp(0,n1,n2,Absyn.BinOp.Op.MOD ):}
  ;

/*3.3.6 additive_exression*/
additive_exression ::=
  multiplication_expression
  | additive_exression:n1 PLUS multiplication_expression:n2
  {:RESULT= new Absyn.BinOp(0, n1,n2, Absyn.BinOp.Op.PLUS):}
  | additive_exression:n1 MINUS multiplication_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.Op.MINUS):}
  ;

/*3.3.7 bwise shift*/
shift_expression ::=
   additive_exression
  | shift_expression:s1 LSHIFT additive_exression:s2
  {:RESULT= new Absyn.BinOp(0, s1,s2,Absyn.BinOp.LSHIFT):}
  | shift_expression:s1 RSHIFT additive_exression:s2
  {:RESULT =new Absyn.BinOp(0,s1,s2,Absyn.BinOp.RSHIFT):}
  ;


/* 3.3.8 relaiton operatiors*/
relational_expression ::= 
  shift_expression
  | relational_expression:n1 LT shift_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.LT):}
  | relational_expression:n1 GT shift_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.GT):}
  | relational_expression:n1 LE shift_expression:n1
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.LE):}
  | relational_expression:n1 GE shift_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.GE):}
  ;

/*3.3.9 equality operatiors*/
equality_expression ::=
  relational_expression
  | equality_expression:n1 EQ relational_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.EQ):}
  | equality_expression:n1 NEQ relational_expression:n2
  {:RESULT= new Absyn.BinOp(0,n1,n2,Absyn.BinOp.NEQ):}
  ;

/*3.3.10 bwise and */
and_expression ::= 
  equality_expression:e
  {:RESULT=e;:}
  | and_expression:e1 AMP equality_expression:e2
  {:RESULT= new Absyn.OpExp(e1,Absyn.Opexp, BAND, e2);:}
  ;

/*3.3.11 bwise exclusice or operator*/
exclusive_or_expression ::=
  and_expression:e
  {:RESULT =e;:}
  | exclusive_or_expression:e1 CARET and_expression:e2
  {:RESULT=new Absyn.OpExp(e1, Absyn.OpExp.BXOR,e2);:}
  ;

/*3.3.12 logical and operatiors*/
inclusive_or_expression ::=
  exclusive_or_expression:e
  {:RESULT=e;:}
  | inclusive_or_expression:e1 PIPE exclusive_or_expression:e2
  {:RESULT=new Absyn.OpExp(e1,Absyn.OpExp.BOR, e2);:}
  ;


/*3.3.13 logical and operator*/
logical_and_expression ::=
  inclusive_or_expression:e
  {:RESULT=e;:}
  | logical_and_expression:e1 ANDAND inclusive_or_expression:e2
  {:RESULT= new Absyn.OpExp(e1, Absyn>OpExp.LAND, e2);:}
  ;

/*3.3.14 logical or */
logical_or_expression ::=
  logical_and_expression:e
  {:RESULT=e;:}
  | logical_or_expression:e1 OROR logical_and_expression:e2
  {:RESULT=new Absyn.OpExp(e1, Absyn.OpExp.LOR, e2);:}
  ;

/*3.3.15 conditional operatiors*/
conditional_expression ::=
  logical_or_expression:e
  {:RESULT=e;:}
  | logical_or_expression:c QUESTION expression:t COLON conditional_expression:f
  {:RESULT= new Absyn.CondExp(c,t,f);:}
  ;

 /*3.3.16 assign ment operatiors*/
 assignment_expression ::=
    conditional_expression:e
    | unary_expression:lhs assignment_operator:op assignment_expression:rhs
    {:RESULT=new Absyn.AssignExp(lhs, op.intValue(), rhs);:}
    ; 

assignment_operator ::=
  EQUALS {:RESULT=Absyn.AssignExp.ASSIGN;:}
  | MUL_ASSIGN 
  {:RESULT=Absyn.AssignExp.MUL;:}
  | DIV_ASSIGN  
  {:RESULT=Absyn.AssignExp.DIV;:}
  | MOD_ASSIGN
  {:RESULT=Absyn.AssignExp.MOD;:}
  | ADD_ASSIGN
  {:RESULT=Absyn.AssignExp.ADD;:}
  | SUB_ASSIGN
  {:RESULT=Absyn.AssignExp.SUB;:}
  | LSHIFT_ASSIGN
  {:RESULT=Absyn.AssignExp.LSHIFT;:}
  | RSHIFT_ASSIGN
  {:RESULT=Absyn.AssignExp.RSHIFT;:}
  | AND_ASSIGN
  {:RESULT=Absyn.AssignExp.AND;:}
  | XOR_ASSIGN
  {:RESULT=Absyn.AssignExp.XOR;:}
  | OR_ASSIGN
  {:RESULT=Absyn.AssignExp.OR;:}
  ;

/*3.3.17 comma */
expression ::= 
  assignment_expression:e
  {:RESULT=e;:}
  | expression:e1 COMMA assignment_expression:e2
  {:RESULT = new Absyn.CommaExp(e1, e2);:}
  ;



/*3.3.4 constant expressions*/
 constant_expression ::=
    conditional_expression
    {:RESULT = e;:}
    ;


/* 3.6 statements*/
statement ::=
  labeled_statement:s
  {:RESULT=s;:}
  | compound_statement:s
{:RESULT=s;:}
  | expression_statement:s
  {:RESULT =s;:}
  | selection_statement:s
{:RESULT=s;:}
  | iteration_statement:s
  {:RESULT=s;:}
  | jump_statement:s
  {:RESULT=s;:}
  ;


/*3.6.1 labled statementts*/
labeled_statement ::=
  ID:id COLON statement:s
  {:RESULT =new Absyn.LableStmt(Symbol.symbol(id),s);:}
  | CASE constant_expression:e COLON statement:s
  {RESULT=new Absyn.CaseStmt(e,s);:}
  | DEFAULT COLON statement:s
  {:RESULT=new Absyn.DefaultStmt(s);:}
  ;


/*3.6.2 compound statemetn or block*/
compound_statement ::=
  LBRACE declaration_list:d statement_list:s RBRACE
  {:RESULT = new Absyn.CompoundStmt(d,s);:}
  | LBRACE declaration_list:d RBRACE
  {:RESULT= new Absyn.CompoundStmt(d, null);:}
  | LBRACE statement_list:s RBRACE
  {:RESULT=new Absyn.CompoundStmt(null,s);:}
  | LBRACE RBRACE
  {:RESULT= new Absyn.CompoundStmt(null, null);:}
  ;

declaration_list ::=
  declatation:d
  {:RESULT=new Absyn.DecList(d, null);:}
  | declaration_list:d declatation:l
  {:RESULT=new Absyn.DecList(d,l);:}
  ;

statement_list ::=
  statement:s
  {:RESULT=new Absyn.StmtList(s,null);:}
  | statement_list:s statement:l
  {:RESULT=new Absyn.StmtList(s,l);:}
  ;
  
/*3.6.3 expression and null 2+2; */
expression_statement ::=
  expression:e SEMICOLON
  {:RESULT = new Absyn.ExpStmt(e);:}
  | SEMICOLON
  {:RESULT=new Absyn.NullStmt();:}
  ;


/*3.6.4 selection statemetn*/
selection_statement ::=
  IF LPAREN expression:c RPAREN statement:t 
  {:RESULT=new Absyn.IfStmt(c,t,null);:}
     %prec LOWER_THAN_ELSE
  | IF LPAREN expression:c RPAREN statement:t ELSE statement:f
  {:RESULT=new Absyn.IfStmt(c,t,f);:}
  | SWITCH LPAREN expression:e RPAREN statement:s
  {:RESULT=new Absyn.SwitchStmt(e,s);:}
  ;

/* 3.6.5 iteration statements*/

iteration_statement ::=
	  WHILE LPAREN expression:c RPAREN statement:s
    {:RESULT=new Absyn.WhileStmt(c,s);:}
    | DO statement:s WHILE LPAREN expression:c RPAREN SEMICOLON
    {:RESULT=new Absyn.DoStmt(s,c);:}
    | FOR LPAREN opt_expression:i SEMICOLON opt_expression:c SEMICOLON
    opt_expression:u RPAREN statement:s
    {:RESULT=new Absyn.ForStmt(i,c,u,s);:}
;

opt_expression::=
  /*empty*/
  {:RESULT=null;:}
  | expression:e
    {:RESULT=e;:}
    ;


jump_statement ::=
  GOTO ID SEMICOLON:id
  {:RESULT=new Absyn.GotoStmt(Synbol.symbol(id));:}
  | CONTINUE SEMICOLON
  {:RESULT= new Absyn.ContinueStmt();:}
  | BREAK SEMICOLON
  {:RESULT=new Absyn.BreakStmt();:}
  | RETURN expression:e SEMICOLON
  {:RESULT=new Absyn.ReturnStmt(e);:}
  |RETURN SEMICOLON
  {:RESULT=new Absyn.ReturnStmt(null);:}
  ;



  /* place holders needs to be taken out later*/


  type_name ::= TYPENAME
  ;