package Parse;


action code {: static Symbol.Symbol sym(String s) {
	         return Symbol.Symbol.symbol(s);
	        }
	    :};

parser code  {: 
  Lexer lexer;

  public void syntax_error(java_cup.runtime.Symbol current) {
   report_error("Syntax error (" + current.sym + ")", current);
  }

  ErrorMsg.ErrorMsg errorMsg;

  public void report_error(String message, java_cup.runtime.Symbol info) {
      errorMsg.error(info.left, message);
  }

  public Grm(Lexer l, ErrorMsg.ErrorMsg err) {
    this();
    errorMsg=err;
    lexer=l;
  }
:};

scan with {: return lexer.nextToken(); :};



terminal String ID, STRING;
terminal Integer DECIMAL_LITERAL;
terminal INT_KEYWORD;

/* Additional C89 tokens recognized by the lexer */
terminal AUTO, CHAR, CONST, DOUBLE, ELIPSES, ENUM, EXTERN,
         FLOAT, FUN, LONG, REGISTER, SHORT, SIGNED, STATIC,
         STRUCT, TYPEDEF, UNION, UNSIGNED, VOID, VOLATILE;
terminal String STRING_LITERAL, CHAR_LITERAL;

terminal COMMA, COLON, SEMICOLON, LPAREN, RPAREN, LBRACK, RBRACK, 
	LBRACE, RBRACE, DOT, PLUS, MINUS, TIMES, DIVIDE, EQ, NEQ, LT, LE, 
	GT, GE, AND, OR, ASSIGN, ARRAY, IF, THEN, ELSE, WHILE, FOR, TO,
	DO, LET, IN, END, OF, BREAK, NIL, FUNCTION, VAR, TYPE;

  /*C tokents added for 3.3.2*/
  terminal ARROW, INCR, DECR;

  /*C tokents for 3.3.3*/
  terminal SIZEOF, AMP, TILDE, BANG;
  /*temp stand in for type name*/
  terminal TYPENAME;

  /*C token for 3.3.5*/
  terminal MOD;
/*C tokent for 3.3.7*/
  terminal LSHIFT, RSHIFT;

  /*C tokens added for 3.3.11-3.3.14*/
  terminal CARET, PIPE, ANDAND, OROR;

  /* tokens for 3.3.15-3.3.16*/
  terminal QUESTION;
  terminal EQUALS, MUL_ASSIGN, DIV_ASSIGN, MOD_ASSIGN, ADD_ASSIGN, SUB_ASSIGN, 
          LSHIFT_ASSIGN, RSHIFT_ASSIGN, AND_ASSIGN, XOR_ASSIGN, OR_ASSIGN;

/*3.6.1*/
terminal CASE, DEFAULT;

/* C token 3.6.4*/
terminal SWITCH;
terminal LOWER_THAN_ELSE;

/* token for 3.6.6*/
terminal GOTO, CONTINUE, RETURN;

/*temp need to be taken out later*/




non terminal Absyn.Exp          Exp;
non terminal Absyn.Var          Var;

/* c grammor from c89*/
non terminal Absyn.Exp primary_expression;
non terminal Absyn.Exp postfix_expression;
non terminal argument_expression_list;
non terminal Absyn.Exp unary_expression;
non terminal unary_operator;
non terminal Absyn.Exp cast_expression;
non terminal Absyn.Exp multiplication_expression;
non terminal Absyn.Exp additive_exression;
non terminal Absyn.Exp shift_expression;
non terminal Absyn.Exp relational_expression;
non terminal Absyn.Exp equality_expression;
non terminal Absyn.Exp and_expression;
non terminal Absyn.Exp exclusive_or_expression;
non terminal Absyn.Exp inclusive_or_expression;
non terminal Absyn.Exp logical_and_expression;
non terminal Absyn.Exp logical_or_expression;
non terminal Absyn.Exp conditional_expression;
non terminal constant_expression;
non terminal assignment_operator;
non terminal Absyn.Exp assignment_expression;
non terminal Absyn.Exp expression;
non terminal type_name;
non terminal Absyn.Stmt statement;
non terminal Absyn.Stmt labeled_statement;
non terminal Absyn.Stmt compound_statement;
non terminal declaration_list;
non terminal Absyn.StmtList statement_list;
non terminal declaration;
non terminal Absyn.Stmt expression_statement;
non terminal Absyn.Stmt selection_statement;
non terminal Absyn.Stmt iteration_statement;
non terminal Absyn.Stmt jump_statement;
/* C89 program structure */
non terminal translation_unit;
non terminal external_declaration;
non terminal function_definition;

precedence nonassoc LOWER_THAN_ELSE;
precedence nonassoc ELSE;
start with translation_unit;
/* C89 program structure */

translation_unit ::=
    external_declaration
  | translation_unit external_declaration
  ;

external_declaration ::=
    function_definition
  | declaration
  ;

function_definition ::=
    INT_KEYWORD ID LPAREN RPAREN compound_statement
  ;

Exp ::= error:e
	  {: RESULT = new Absyn.SeqExp(eleft, null); :}
	| Var:v
	  {: RESULT = new Absyn.VarExp(vleft, v); :}
	;

Var ::=   ID:n
	  {: RESULT = new Absyn.SimpleVar(nleft, sym(n)); :}
	;


/*3.3.1 primary expressions*/
primary_expression ::=
  ID  /* identifier*/
 | DECIMAL_LITERAL:n {: RESULT = new Absyn.IntExp(nleft, n.intValue()); :} /* constant*/
 | STRING /* string literal*/
 | LPAREN expression RPAREN
  ;


/*3.3.2 postfix*/
postfix_expression ::=
  primary_expression:e {: RESULT = e; :}
|  postfix_expression:e {: RESULT = e; :} LBRACK expression RBRACK
|  postfix_expression LPAREN RPAREN
|  postfix_expression LPAREN argument_expression_list RPAREN
|  postfix_expression DOT ID
|  postfix_expression ARROW ID
|  postfix_expression INCR
|  postfix_expression DECR
  ;

argument_expression_list ::=
  assignment_expression
 | argument_expression_list COMMA assignment_expression
  ;


/* 3.3.3 unary operatiors*/
unary_expression ::=
  postfix_expression
  | INCR unary_expression
  | DECR unary_expression
  | unary_operator cast_expression
  | SIZEOF LPAREN type_name RPAREN
  ;

unary_operator ::=
  AMP 
  | TIMES
  | PLUS
  | MINUS 
  | TILDE
  | BANG
  ;

/*3.3.4*/
cast_expression ::=
  unary_expression:e {: RESULT = e; :}
  ;


/*3.3.5*/
multiplication_expression ::= 
  cast_expression:e {: RESULT = e; :}
  | multiplication_expression:e {: RESULT = e; :} TIMES cast_expression
  | multiplication_expression DIVIDE cast_expression
  | multiplication_expression MOD cast_expression
  ;

/*3.3.6 additive_exression*/
additive_exression ::=
  multiplication_expression
  | additive_exression:e {: RESULT = e; :} PLUS multiplication_expression
  | additive_exression MINUS multiplication_expression
  ;

/*3.3.7 bwise shift*/
shift_expression ::=
   additive_exression
  | shift_expression:e {: RESULT = e; :} LSHIFT additive_exression
  | shift_expression RSHIFT additive_exression
  ;


/* 3.3.8 relaiton operatiors*/
relational_expression ::= 
  shift_expression
  | relational_expression:e {: RESULT = e; :} LT shift_expression
  | relational_expression GT shift_expression
  | relational_expression LE shift_expression
  | relational_expression GE shift_expression
  ;

/*3.3.9 equality operatiors*/
equality_expression ::=
  relational_expression
  | equality_expression:e {: RESULT = e; :} EQ relational_expression
  | equality_expression NEQ relational_expression
  ;

/*3.3.10 bwise and */
and_expression ::= 
  equality_expression
  | and_expression:e {: RESULT = e; :} AMP equality_expression
  ;

/*3.3.11 bwise exclusice or operator*/
exclusive_or_expression ::=
  and_expression
  | exclusive_or_expression:e {: RESULT = e; :} CARET and_expression
  ;

/*3.3.12 logical and operatiors*/
inclusive_or_expression ::=
  exclusive_or_expression
  | inclusive_or_expression:e {: RESULT = e; :} PIPE exclusive_or_expression
  ;


/*3.3.13 logical and operator*/
logical_and_expression ::=
  inclusive_or_expression
  | logical_and_expression:e {: RESULT = e; :} ANDAND inclusive_or_expression
  ;

/*3.3.14 logical or */
logical_or_expression ::=
  logical_and_expression
  | logical_or_expression:e {: RESULT = e; :} OROR logical_and_expression
  ;

/*3.3.15 conditional operatiors*/
conditional_expression ::=
  logical_or_expression
  | logical_or_expression QUESTION expression COLON conditional_expression
  ;

 /*3.3.16 assign ment operatiors*/
 assignment_expression ::=
    conditional_expression:e {: RESULT = e; :}
    | unary_expression assignment_operator assignment_expression
    ; 

assignment_operator ::=
  EQUALS 
  | MUL_ASSIGN
  | DIV_ASSIGN 
  | MOD_ASSIGN
  | ADD_ASSIGN
  | SUB_ASSIGN
  | LSHIFT_ASSIGN
  | RSHIFT_ASSIGN
  | AND_ASSIGN
  | XOR_ASSIGN
  | OR_ASSIGN
  ;

/*3.3.17 comma */
expression ::= 
  assignment_expression:e {: RESULT = e; :}
  | expression COMMA assignment_expression
  ;



/*3.3.4 constant expressions*/
 constant_expression ::=
    conditional_expression
    ;


/* 3.6 statements*/
statement ::=
    labeled_statement:s
      {: RESULT = s; :}
  | compound_statement:s
      {: RESULT = s; :}
  | expression_statement:s
      {: RESULT = s; :}
  | selection_statement:s
      {: RESULT = s; :}
  | iteration_statement:s
      {: RESULT = s; :}
  | jump_statement:s
      {: RESULT = s; :}
  ;

/*3.6.1 labled statementts*/
labeled_statement ::=
  ID COLON statement
  | CASE constant_expression COLON statement
  | DEFAULT COLON statement
  ;


/*3.6.2 compound statemetn or block*/
compound_statement ::=
  LBRACE declaration_list statement_list RBRACE
  | LBRACE declaration_list RBRACE
  | LBRACE statement_list RBRACE
  | LBRACE RBRACE
  ;
/* Simple C variable declaration */
declaration ::=
    INT_KEYWORD ID SEMICOLON
  ;
declaration_list ::=
    declaration
  | declaration_list declaration
  ;
statement_list ::=
    statement:s
      {: RESULT = new Absyn.StmtList(s, null); :}
  | statement_list:list statement:s
      {: RESULT = new Absyn.StmtList(s, list); :}
  ;
  
expression_statement ::=
    expression:e SEMICOLON
      {: RESULT = new Absyn.ExprStmt(eleft, e); :}
  | SEMICOLON:s
      {: RESULT = new Absyn.ExprStmt(sleft, null); :}
  ;


/*3.6.4 selection statemetn*/
selection_statement ::=
  IF LPAREN expression RPAREN statement %prec LOWER_THAN_ELSE
  | IF LPAREN expression RPAREN statement ELSE statement
  | SWITCH LPAREN expression RPAREN statement
  ;

/* 3.6.5 iteration statements*/

iteration_statement ::=
	  WHILE LPAREN expression RPAREN statement
	| DO statement WHILE LPAREN expression RPAREN SEMICOLON
	| FOR LPAREN expression SEMICOLON expression SEMICOLON expression RPAREN statement
	| FOR LPAREN expression SEMICOLON expression SEMICOLON            RPAREN statement
	| FOR LPAREN expression SEMICOLON            SEMICOLON expression RPAREN statement
	| FOR LPAREN expression SEMICOLON            SEMICOLON            RPAREN statement
	| FOR LPAREN            SEMICOLON expression SEMICOLON expression RPAREN statement
	| FOR LPAREN            SEMICOLON expression SEMICOLON            RPAREN statement
	| FOR LPAREN            SEMICOLON            SEMICOLON expression RPAREN statement
	| FOR LPAREN            SEMICOLON            SEMICOLON            RPAREN statement
	;

jump_statement ::=
  GOTO ID SEMICOLON
  | CONTINUE SEMICOLON
  | BREAK SEMICOLON
  | RETURN:r expression:e SEMICOLON {: RESULT = new Absyn.ReturnStmt(rleft, e); :}
  |RETURN SEMICOLON
  ;



  /* place holders needs to be taken out later*/


  type_name ::= TYPENAME
  ;